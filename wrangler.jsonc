{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-earth-tools",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/app-router-entry",
  "assets": {
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "openearthtools.anthonynboyd.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-earth-tools",
      "database_id": "80c86b6d-75d0-4544-b4ac-827322ccad53",
      "migrations_dir": "migrations"
    }
  ]
  // Cloudflare Access settings for /admin are Worker secrets, not vars, so deploys never reset them:
  //   npx wrangler secret put ACCESS_TEAM_DOMAIN   (e.g. your-team.cloudflareaccess.com)
  //   npx wrangler secret put ACCESS_AUD           (the Access application's AUD tag)
  // Admin requests are refused while either is missing.
}
