# Copy to .dev.vars for local development. Never deploy this file.

# Lets /admin work on localhost without Cloudflare Access.
# Ignored for any host other than localhost or 127.0.0.1.
ADMIN_DEV_BYPASS=true

# Cloudflare's Turnstile test keys, which always pass. They enable the Suggest a Tool form locally.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
